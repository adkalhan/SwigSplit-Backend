{
  "name": "swigsplit-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.11.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "npm run build --workspace=@swigsplit/api && npm run build --workspace=@swigsplit/worker",
    "dev": "npm run start:dev --workspace=@swigsplit/api",
    "start": "npm run start --workspace=@swigsplit/api",
    "start:worker": "npm run start --workspace=@swigsplit/worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "prisma:generate": "npm run prisma:generate --workspace=@swigsplit/database",
    "prisma:migrate": "npm run prisma:migrate --workspace=@swigsplit/database"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-fastify": "^11.0.1",
    "@nestjs/testing": "^11.0.1",
    "@types/node": "^22.10.2",
    "supertest": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
