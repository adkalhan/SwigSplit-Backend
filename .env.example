NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://swigsplit:swigsplit@localhost:5432/swigsplit?schema=public
# Keep this separate from DATABASE_URL. It is reserved for database-backed tests.
TEST_DATABASE_URL=postgresql://swigsplit:swigsplit@localhost:5432/swigsplit_test?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000
# Must be an HTTPS origin. Invite links are returned as <APP_WEB_URL>/signup?invite=<token>.
APP_WEB_URL=https://app.example.com
LOG_LEVEL=info
BODY_LIMIT_BYTES=1048576
# Replace before deployment. Do not commit a real secret.
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
